        {
            "name": "exemptadd",
            "type": "exemptadd",
            "ricardian_contract": "Excuse an account from the transfer fee in both directions. {{issuer_authority}} {{fee_policy}}"
        },
        {
            "name": "exemptdel",
            "type": "exemptdel",
            "ricardian_contract": "Remove an account's transfer-fee exemption. {{issuer_authority}} {{fee_policy}}"
        },
        {
            "name": "exemptlock",
            "type": "exemptlock",
            "ricardian_contract": "Mark a fee exemption as load-bearing, so it cannot be removed while a fee is in force. {{issuer_authority}} {{exemption_lock}}"
        },
        {
            "name": "exemptunlock",
            "type": "exemptunlock",
            "ricardian_contract": "Release a load-bearing fee exemption. Permitted only while every transfer fee is set to zero. {{issuer_authority}} {{exemption_lock}}"
        },
        {
            "name": "feeapply",
            "type": "feeapply",
            "ricardian_contract": "Put a previously announced fee increase into effect after its notice period has elapsed. {{issuer_authority}} {{fee_policy}}"
        },
        {
            "name": "feecancel",
            "type": "feecancel",
            "ricardian_contract": "Abandon an announced fee increase before it takes effect. {{issuer_authority}}"
        },
        {
            "name": "issue",
            "type": "issue",
            "ricardian_contract": "Mint new tokens into the issuer balance, up to the maximum supply. {{issuer_authority}} {{supply_finality}}"
        },
        {
            "name": "logburn",
            "type": "logburn",
            "ricardian_contract": "Record that a transfer fee of {{fee}} was destroyed. {{receipt_only}}"
        },
        {
            "name": "open",
            "type": "open",
            "ricardian_contract": "Create a zero balance row for an account, paid for by the signing RAM payer. {{user_authority}}"
        },
        {
            "name": "retire",
            "type": "retire",
            "ricardian_contract": "Permanently destroy tokens held by the issuer, reducing circulating supply. {{issuer_authority}} {{irreversible_destruction}}"
