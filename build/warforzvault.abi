        {
            "name": "setfee",
            "type": "setfee",
            "ricardian_contract": "Set the burned transfer fee rate for this symbol. A reduction takes effect at once; an increase is announced and takes effect only after the published notice period. {{issuer_authority}} {{fee_policy}}"
