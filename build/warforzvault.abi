    "ricardian_clauses": [
        {
            "id": "user_authority",
            "body": "The signer authorizes only the state transition described by this action and acknowledges that blockchain transactions are public and irreversible."
        },
        {
            "id": "issuer_authority",
            "body": "This action is restricted to the contract account or the account recorded as the token issuer. The issuer is responsible for the token's monetary policy and for validating supply and fee values before signing."
        },
        {
            "id": "dual_authority",
            "body": "This action requires two independent signatures: the account currently recorded as issuer, and the contract account itself. Neither key alone can move the authority to mint or retire this token. The signers accept that after this action the previous issuer permanently loses that authority."
        },
        {
            "id": "supply_finality",
            "body": "The maximum supply is fixed when the symbol is created and cannot be raised by any action in this contract. Tokens issued within that ceiling enter circulation immediately."
        },
        {
            "id": "irreversible_destruction",
            "body": "Tokens destroyed by this action are removed from circulating supply and cannot be recovered. The maximum supply is unchanged, so the destroyed amount may be issued again by the issuer at a later time."
        },
        {
            "id": "transfer_fee",
            "body": "A transfer fee may apply. Where it does, the sender is debited the full stated quantity, the recipient is credited the quantity less the fee, and the fee is permanently destroyed rather than paid to any party. The fee rate is published on-chain and is zero when either the sender or the recipient holds a fee exemption. Recipients should read their resulting balance rather than assume the stated quantity was delivered in full."
        },
        {
            "id": "fee_policy",
            "body": "This action changes who pays the transfer fee, or how much it is. The rate is bounded by the contract and cannot be raised beyond that ceiling. An increase to an already-active fee cannot take effect until the published notice period has elapsed. A fee cannot be brought into force while no exemption is locked."
        },
        {
            "id": "exemption_lock",
            "body": "A locked exemption cannot be deleted, and cannot be unlocked while any transfer fee is in force. This protects contracts whose internal accounting depends on receiving the full transferred amount. The signer accepts that releasing such an exemption requires first setting every transfer fee to zero."
        },
        {
            "id": "receipt_only",
            "body": "This action records information in the transaction history and changes no balance, supply, or configuration. It can be authorized only by the contract itself and notifies no other account."
        },
        {
            "id": "memo_visibility",
            "body": "The memo is stored in the public transaction history, is readable by anyone, and may be interpreted as an instruction by a receiving smart contract."
        }
    ],
